# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — real secrets must never be committed.
# Defaults shown here match the local mock setup (mock key, localhost).

STREAMGUARD_API_KEY=your-mock-api-key-here
STREAMGUARD_API_URL=http://127.0.0.1:8000/v1/transactions
STREAMGUARD_REDPANDA_BROKER=localhost:19092
STREAMGUARD_TOPIC=transactions-raw
STREAMGUARD_BATCH_SIZE=20
STREAMGUARD_SLEEP_INTERVAL=0.5
STREAMGUARD_DATASET_PATH=PS_20174392719_1491204439457_log.csv
STREAMGUARD_DATASET_PARQUET=PS_20174392719_1491204439457_log.parquet

# S3 sink (minIO mock first, then real AWS — SUGGESTIONS #2).
# Leave STREAMGUARD_S3_BUCKET unset to keep writing Bronze locally.
# Provider: "minio" (endpoint + static keys) or "aws" (DefaultAWSCredentialsProviderChain).
STREAMGUARD_S3_PROVIDER=minio
STREAMGUARD_S3_BUCKET=streamguard-lakehouse
STREAMGUARD_S3_ENDPOINT=http://localhost:9000
STREAMGUARD_S3_ACCESS_KEY=minioadmin
STREAMGUARD_S3_SECRET_KEY=minioadmin

# Phase 6 + 7 — real-time scoring (src/api/main.py, src/consumer/main.py).
# The scoring service defaults to :8001 (the mock vendor feed owns :8000).
STREAMGUARD_SCORER_URL=http://127.0.0.1:8001/v1/predict
STREAMGUARD_SCORER_TIMEOUT=2.0
STREAMGUARD_ALERTS_TOPIC=fraud-alerts
STREAMGUARD_CONSUMER_GROUP=streamguard-scorer
STREAMGUARD_POLL_TIMEOUT_MS=1000

# Phase 8 — GDPR Article 17 erasure requests (live streaming purge).
STREAMGUARD_GDPR_TOPIC=gdpr-deletion-requests

# Phase 9 — CloudWatch observability (src/consumer/main.py).
# Requires valid AWS credentials in the environment / ~/.aws. Set to 0 to
# disable metric emission for local runs without AWS.
STREAMGUARD_CLOUDWATCH_ENABLED=1
STREAMGUARD_CLOUDWATCH_NAMESPACE=StreamGuard/Inference
AWS_REGION=us-east-1
